{
  "name": "beats-your-music",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,green \"npm:server\" \"vite --host 127.0.0.1\"",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:browser:i18n": "node tests/browser-i18n-smoke.mjs",
    "test:browser:multi": "node tests/browser-multi-smoke.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "multer": "^2.0.2",
    "music-tempo": "^1.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^13.0.0",
    "vite": "^7.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "supertest": "^7.1.4",
    "vitest": "^4.0.13"
  }
}
